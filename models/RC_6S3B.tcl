    set status [lindex $result 0];
    set roofDisp [lindex $result 1];
    puts "Running status: $status";
    puts "Roof displacement: $roofDisp";
    puts "Roof drift ratio: [expr $roofDisp / $HBuilding]";

# ------------------------------- Cyclic pushover --------------------------------

} elseif {$analysis_type == "CP"} {

    set RDR_path [list 0 0.02 -0.02 0];  # $$$

    set m2 90.4351;
    set m3 89.349538;
    set m4 88.176864;
    set m5 87.00419;
    set m6 87.00419;
    set m7 76.508396;

    set F2 [expr $m2 * $g * [lindex $mode_list 0]];
    set F3 [expr $m3 * $g * [lindex $mode_list 1]];
    set F4 [expr $m4 * $g * [lindex $mode_list 2]];
    set F5 [expr $m5 * $g * [lindex $mode_list 3]];
    set F6 [expr $m6 * $g * [lindex $mode_list 4]];
    set F7 [expr $m7 * $g * [lindex $mode_list 5]];
    set file_pattern [open $MainFolder/$SubFolder/Pattern.out w]
    puts $file_pattern $F2
    puts $file_pattern $F3
    puts $file_pattern $F4
    puts $file_pattern $F5
    puts $file_pattern $F6
    puts $file_pattern $F7
    close $file_pattern
    pattern Plain 222 Linear {
        load 10020204 $F2 0.0 0.0;
        load 10030204 $F3 0.0 0.0;
        load 10040204 $F4 0.0 0.0;
        load 10050204 $F5 0.0 0.0;
        load 10060204 $F6 0.0 0.0;
        load 10070204 $F7 0.0 0.0;
    };
    set CtrlNode 10070204;
    set Dincr 0.5;
    set result [CyclicPushover $CtrlNode $RDR_path $HBuilding $Dincr $maxRunTime];
    set status [lindex $result 0];
    puts "Running status: $status";

}

set file_status [open "$MainFolder/$SubFolder/Status.dat" w]
puts $file_status $status
close $file_status
wipe all


