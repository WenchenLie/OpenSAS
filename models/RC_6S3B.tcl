    region 1 -eleOnly {*}$beam_Ids -rayleigh 0.0 0.0 $a1_mod 0.0;
    region 2 -eleOnly {*}$column_Ids -rayleigh 0.0 0.0 $a1_mod 0.0;
    region 3 -nodeOnly {*}$mass_Ids -rayleigh $a0 0.0 0.0 0.0;
    # rayleigh $a0 0.0 $a1 0.0;

    # Ground motion acceleration file input
    timeSeries Path 200 -dt $GMdt -filePath $GMFile -factor [expr $EqSF * $g];
